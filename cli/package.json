{
  "name": "@yousef/ai-toolkit-cli",
  "version": "0.1.0",
  "description": "CLI to install skills/agents from ai-toolkit into a project, following each AI tool's folder conventions (Claude Code, OpenCode, ...)",
  "type": "module",
  "bin": {
    "toolkit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean --shims",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "tabtab": "^3.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "@types/tabtab": "^3.0.4",
    "tsup": "^8.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
