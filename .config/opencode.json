{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    }
  },
  "provider": {
    "sovereigneg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SovereignEG",
      "options": {
        "baseURL": "https://backend.sovereigneg.com/v1",
        "apiKey": "{env:SOVEREIGNEG_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deppseek V4 Flash"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "refinedneuro/vibethinker-3b-hermes:latest": {
          "name": "VibeThinker 3B Hermes"
        }
      }
    }
  }
}
